# PCI KPI Management — environment variables
# Copy to .env and fill in real values. Never commit .env to git.

# Railway PostgreSQL (use public URL for local dev)
DATABASE_URL=postgresql://postgres:password@host:port/railway

PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Local dev auth bypass (set DEV_BYPASS_AUTH=false in production)
DEV_BYPASS_AUTH=true
DEV_AUTH_TOKEN=local-dev-token
DEV_USER_EMAIL=btraweek@pcigases.com
DEV_USER_NAME=Dev User
DEV_USER_DEPARTMENT=Operations

# Portal auth (production)
PORTAL_ISSUER=https://pci-intranet-api-production.up.railway.app
# PORTAL_JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
PORTAL_APP_ID=kpi
SESSION_JWT_SECRET=generate-a-long-random-secret-for-production

# Optional: comma-separated admin emails for /api/me isHrAdmin
# KPI_ADMIN_EMAILS=btraweek@pcigases.com,grace.mensah@pcigases.com

# Optional: CEO/CFO executive approval emails
# KPI_EXECUTIVE_EMAILS=ceo@pci.com,cfo@pci.com

# Optional: disable SSL for local Postgres
# PGSSLMODE=disable
